# Supplied by systemd EnvironmentFile in production; never put Secrets here.
SIGNAGE_BACKEND_HOST=127.0.0.1
SIGNAGE_BACKEND_PORT=3000
SIGNAGE_LOG_LEVEL=info
SIGNAGE_SHUTDOWN_TIMEOUT_MS=10000
# Existing directory owned by the Backend user, mode 0700; DB and lock are fixed names.
SIGNAGE_DATA_DIR=/var/lib/home-digital-signage
# Google Calendar ID for the Schedule (Issue #10). Unset disables it; never commit the real ID.
# SIGNAGE_SCHEDULE_CALENDAR_ID=<calendar-id>
# Open-Meteo weather location (Issue #9). Set both or neither; unset disables the weather.
# Round to 2 decimal places; never commit the real location.
# SIGNAGE_WEATHER_LATITUDE=<latitude>
# SIGNAGE_WEATHER_LONGITUDE=<longitude>
