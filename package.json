{
  "name": "home-digital-signage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.frontend.json",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "build:backend": "tsc -p tsconfig.backend.json",
    "dev:frontend": "vite --config vite.frontend.config.ts",
    "build:frontend": "vite build --config vite.frontend.config.ts",
    "start:backend": "sh scripts/with-backend-lock.sh backend",
    "provision:backend": "sh scripts/with-backend-lock.sh provision"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/zen-maru-gothic": "5.3.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "pino": "10.4.0"
  }
}
