{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh pr create *)",
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "Bash(npm run typecheck)",
      "Bash(npm test *)",
      "Bash(npm run check)",
      "PowerShell(git *)",
      "PowerShell(gh pr create *)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run format:check)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm test *)",
      "PowerShell(npm run check)"
    ],
    "ask": [
      "Bash(npm ci *)",
      "Bash(npm install *)",
      "Bash(npm run format *)",
      "Bash(git push origin main*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push * :*)",
      "Bash(git clean *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue close *)",
      "PowerShell(npm ci *)",
      "PowerShell(npm install *)",
      "PowerShell(npm run format *)",
      "PowerShell(git push origin main*)",
      "PowerShell(git push * HEAD:main*)",
      "PowerShell(git push --delete *)",
      "PowerShell(git push * --delete *)",
      "PowerShell(git push * :*)",
      "PowerShell(git clean *)",
      "PowerShell(gh pr edit *)",
      "PowerShell(gh pr comment *)",
      "PowerShell(gh issue create *)",
      "PowerShell(gh issue edit *)",
      "PowerShell(gh issue comment *)",
      "PowerShell(gh issue close *)"
    ],
    "deny": [
      "Bash(git merge *)",
      "Bash(gh pr merge *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "PowerShell(git merge *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(Get-Content *.env)",
      "PowerShell(Get-Content *secrets*)",
      "Read(/config/backend.env)",
      "Read(secrets/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(//etc/home-digital-signage/**)",
      "Edit(/config/backend.env)",
      "Edit(secrets/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Edit(//etc/home-digital-signage/**)"
    ]
  }
}
