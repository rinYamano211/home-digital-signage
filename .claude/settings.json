{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch -vv)",
      "Bash(git worktree list)",
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "Bash(npm run typecheck)",
      "Bash(npm test *)",
      "Bash(npm run check)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git branch -a)",
      "PowerShell(git branch -vv)",
      "PowerShell(git worktree list)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run format:check)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm test *)",
      "PowerShell(npm run check)"
    ],
    "ask": [
      "Bash(git fetch *)",
      "Bash(npm ci *)",
      "Bash(npm install *)",
      "Bash(npm run format *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment *)",
      "PowerShell(git fetch *)",
      "PowerShell(npm ci *)",
      "PowerShell(npm install *)",
      "PowerShell(npm run format *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git rebase *)",
      "PowerShell(git reset *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr edit *)",
      "PowerShell(gh pr comment *)",
      "PowerShell(gh issue create *)",
      "PowerShell(gh issue edit *)",
      "PowerShell(gh issue comment *)"
    ],
    "deny": [
      "Bash(git merge *)",
      "Bash(gh pr merge *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "PowerShell(git merge *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(Get-Content *.env)",
      "PowerShell(Get-Content *secrets*)",
      "Read(/config/backend.env)",
      "Read(secrets/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(//etc/home-digital-signage/**)",
      "Edit(/config/backend.env)",
      "Edit(secrets/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Edit(//etc/home-digital-signage/**)"
    ]
  }
}
